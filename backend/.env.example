# Domain the relay serves tunnels on: <service>.ROXEY_DOMAIN
ROXEY_DOMAIN=roxey.run

# Host the REST API + dashboard + CLI websocket live on (must be a real
# DNS record pointing at this server; the wildcard *.ROXEY_DOMAIN covers it
# via Cloudflare, so no separate record is strictly needed, but keeping one
# is clearer). Defaults to relay.<ROXEY_DOMAIN>.
ROXEY_ADMIN_HOST=relay.roxey.run

# Basic auth for the dashboard + REST API (key management, tunnel list).
ROXEY_ADMIN_USER=admin
ROXEY_ADMIN_PASS=change-me

# Where the SQLite file for API keys is written.
ROXEY_DB_PATH=roxey.db

# Port the relay listens on. Put Cloudflare (or any TLS-terminating proxy)
# in front of this; the relay itself speaks plain HTTP.
PORT=8080
