# Domain the relay serves tunnels on: <service>-<suffix>.ROXEY_DOMAIN
ROXEY_DOMAIN=roxey.run

# Host the dashboard + REST API + CLI websocket live on (must be a real
# DNS record pointing at this server; the wildcard *.ROXEY_DOMAIN covers it
# via Cloudflare, so no separate record is strictly needed, but keeping one
# is clearer). Defaults to roxey.<ROXEY_DOMAIN>.
ROXEY_ADMIN_HOST=relay.roxey.run

# HMAC secret for session + tunnel-gate cookies. If unset, a random secret
# is generated and persisted next to the database (restarts keep sessions).
# Set it explicitly when running multiple replicas.
ROXEY_SESSION_SECRET=

# Open signup: anyone can create an account and mint API keys. Leave unset
# for the hosted/community experience; see SINGLE_USER below to lock down.
# ROXEY_SINGLE_USER=1

# Single-user mode: disables signup and seeds one account idempotently
# (the password hash is refreshed from env on every start). Tunnels are
# served on bare <service>.<tld> instead of namespaced hosts.
# ROXEY_ADMIN_EMAIL=me@example.com
# ROXEY_ADMIN_PASSWORD=change-me

# Where the SQLite file for accounts, keys and tunnel history is written.
ROXEY_DB_PATH=roxey.db

# Port the relay listens on. Put Cloudflare (or any TLS-terminating proxy)
# in front of this; the relay itself speaks plain HTTP.
PORT=8080
